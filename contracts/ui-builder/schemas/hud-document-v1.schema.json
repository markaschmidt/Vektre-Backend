            "maxLength": 512,
            "type": "string"
          },
          "content": {
            "$ref": "#/$defs/__schema0"
          },
          "id": {
            "$ref": "#/$defs/__schema2"
          },
          "interactions": {
            "items": {
              "$ref": "#/$defs/__schema0"
            },
            "type": "array"
          },
          "kind": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "layout": {
            "$ref": "#/$defs/__schema0"
          },
          "parentId": {
            "$ref": "#/$defs/__schema2"
          },
          "states": {
            "$ref": "#/$defs/__schema0"
          },
          "styleRef": {
            "$ref": "#/$defs/__schema2"
          },
          "surfaceId": {
            "$ref": "#/$defs/__schema2"
          },
          "transform": {
            "$ref": "#/$defs/__schema0"
          },
          "visibilityRules": {
            "items": {
              "$ref": "#/$defs/__schema0"
            },
            "type": "array"
          },
