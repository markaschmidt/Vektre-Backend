        "$ref": "#/$defs/__schema0"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "type": "array"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "type": "array"
    },
    "designTokens": {
      "$ref": "#/$defs/__schema0"
    },
    "metadata": {
      "$ref": "#/$defs/__schema0"
    },
    "nodes": {
