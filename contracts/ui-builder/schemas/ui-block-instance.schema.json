{
  "$comment": "Vektre contract version 1",
  "$defs": {
    "__schema0": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$",
      "type": "string"
    },
    "__schema1": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "__schema2": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 0,
          "type": "number"
        },
        "width": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "__schema3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "type": "object"
    },
    "__schema4": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema4"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema4"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "__schema5": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^\\/(?:[^/~]|~[01])+(?:\\/(?:[^/~]|~[01])+)*$",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "path",
        "value"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.vektre.dev/ui-builder/ui-block-instance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "definitionId": {
      "$ref": "#/$defs/__schema0"
    },
    "definitionVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "layout": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "space_between"
          ],
          "type": "string"
        },
        "anchor": {
          "enum": [
            "top_left",
            "top",
            "top_right",
            "left",
            "center",
            "right",
            "bottom_left",
            "bottom",
            "bottom_right",
            "stretch"
          ],
          "type": "string"
        },
        "gap": {
          "minimum": 0,
          "type": "number"
        },
        "gridColumns": {
          "exclusiveMinimum": 0,
          "maximum": 64,
          "type": "integer"
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "space_between"
          ],
          "type": "string"
        },
        "maxSize": {
          "$ref": "#/$defs/__schema2"
        },
        "minSize": {
          "$ref": "#/$defs/__schema2"
        },
        "mode": {
          "enum": [
            "absolute",
            "row",
            "column",
            "grid",
            "stack"
          ],
          "type": "string"
        },
        "padding": {
          "additionalProperties": false,
          "properties": {
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            },
            "right": {
              "type": "number"
            },
            "top": {
              "type": "number"
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "type": "object"
        },
        "position": {
          "$ref": "#/$defs/__schema1"
        },
        "size": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/__schema4"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "overrides": {
      "items": {
        "$ref": "#/$defs/__schema5"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "parameterValues": {
      "additionalProperties": {
        "$ref": "#/$defs/__schema4"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "parentId": {
      "$ref": "#/$defs/__schema0"
    },
    "screenId": {
      "$ref": "#/$defs/__schema0"
    },
    "surfaceId": {
      "$ref": "#/$defs/__schema0"
    },
    "transform": {
      "additionalProperties": false,
      "properties": {
        "pivot": {
          "$ref": "#/$defs/__schema1"
        },
        "rotationDegrees": {
          "$ref": "#/$defs/__schema3"
        },
        "scale": {
          "$ref": "#/$defs/__schema3"
        },
        "translation": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "type": "object"
    },
    "zIndex": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "definitionId",
    "definitionVersion",
    "screenId",
    "surfaceId",
    "layout",
    "zIndex",
    "parameterValues",
    "overrides"
  ],
  "title": "UI Block Instance",
  "type": "object"
}
