{
  "$comment": "Vektre contract version 1",
  "$defs": {
    "__schema0": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema1"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "__schema2": {
      "additionalProperties": false,
      "properties": {
        "contentHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceKind": {
          "enum": [
            "message",
            "document",
            "screen",
            "group",
            "component",
            "block",
            "asset",
            "storyboard",
            "comment",
            "artifact",
            "memory"
          ],
          "type": "string"
        },
        "visibility": {
          "enum": [
            "shared",
            "private",
            "system"
          ],
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "sourceKind",
        "contentHash",
        "visibility"
      ],
      "type": "object"
    },
    "__schema3": {
      "maxLength": 2048,
      "type": "string"
    }
  },
  "$id": "https://schemas.vektre.dev/ui-builder/agent-stage-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "citations": {
      "items": {
        "$ref": "#/$defs/__schema2"
      },
      "maxItems": 256,
      "type": "array"
    },
    "repairAttempts": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "$ref": "#/$defs/__schema1"
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "stage": {
      "enum": [
        "understand",
        "propose_ux",
        "propose_visual",
        "analyze_references",
        "plan_patch",
        "match_compose",
        "critique_validate"
      ],
      "type": "string"
    },
    "stageExecutionId": {
      "$ref": "#/$defs/__schema0"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "cachedInputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "imageInputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "inputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "outputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "providerCostUsd": {
          "minimum": 0,
          "type": "number"
        },
        "providerRequestId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "reasoningTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "model",
        "inputTokens",
        "cachedInputTokens",
        "imageInputTokens",
        "outputTokens",
        "reasoningTokens"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/__schema3"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "stageExecutionId",
    "runId",
    "stage",
    "result",
    "citations",
    "warnings",
    "repairAttempts"
  ],
  "title": "Agent Stage Result",
  "type": "object"
}
