{
  "$comment": "Vektre contract version 1",
  "$defs": {
    "__schema0": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "__schema1": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    }
  },
  "$id": "https://schemas.vektre.dev/ui-builder/agent-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activityId": {
      "$ref": "#/$defs/__schema0"
    },
    "actorId": {
      "$ref": "#/$defs/__schema0"
    },
    "baseDocumentHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "contextManifestId": {
      "$ref": "#/$defs/__schema0"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema1"
    },
    "documentId": {
      "$ref": "#/$defs/__schema0"
    },
    "intent": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "projectId": {
      "$ref": "#/$defs/__schema0"
    },
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "status": {
      "enum": [
        "created",
        "awaiting_context",
        "understanding",
        "awaiting_clarification",
        "planning",
        "generating_ux_visual",
        "awaiting_assets",
        "matching",
        "composing",
        "validating",
        "awaiting_review",
        "needs_rebase",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "threadId": {
      "$ref": "#/$defs/__schema0"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "runId",
    "requestId",
    "activityId",
    "projectId",
    "documentId",
    "threadId",
    "actorId",
    "status",
    "intent",
    "baseDocumentHash",
    "createdAt",
    "updatedAt"
  ],
  "title": "Agent Run",
  "type": "object"
}
