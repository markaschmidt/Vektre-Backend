{
  "$comment": "Vektre contract version 1",
  "$defs": {
    "__schema0": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema1"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "__schema2": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    }
  },
  "$id": "https://schemas.vektre.dev/ui-builder/design-memory-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "$ref": "#/$defs/__schema2"
    },
    "documentId": {
      "$ref": "#/$defs/__schema0"
    },
    "effectiveRevision": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "lore",
        "aesthetic",
        "constraint",
        "decision",
        "rejected_direction",
        "interaction_rule",
        "terminology"
      ],
      "type": "string"
    },
    "memoryId": {
      "$ref": "#/$defs/__schema0"
    },
    "ownerUserId": {
      "$ref": "#/$defs/__schema0"
    },
    "pinned": {
      "type": "boolean"
    },
    "projectId": {
      "$ref": "#/$defs/__schema0"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "$ref": "#/$defs/__schema0"
        },
        "documentRevision": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "sourceId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceKind": {
          "enum": [
            "message",
            "comment",
            "run",
            "user",
            "memory",
            "thread",
            "migration"
          ],
          "type": "string"
        }
      },
      "required": [
        "sourceKind",
        "sourceId"
      ],
      "type": "object"
    },
    "reviewedAt": {
      "$ref": "#/$defs/__schema2"
    },
    "reviewedByUserId": {
      "$ref": "#/$defs/__schema0"
    },
    "scope": {
      "enum": [
        "organization",
        "project",
        "document",
        "screen",
        "block",
        "group",
        "component"
      ],
      "type": "string"
    },
    "scopeId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$",
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ],
      "type": "string"
    },
    "structuredValue": {
      "$ref": "#/$defs/__schema1"
    },
    "supersededByMemoryId": {
      "$ref": "#/$defs/__schema0"
    },
    "text": {
      "maxLength": 10000,
      "minLength": 1,
      "type": "string"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema2"
    },
    "visibility": {
      "enum": [
        "shared",
        "private"
      ],
      "type": "string"
    }
  },
  "required": [
    "memoryId",
    "projectId",
    "kind",
    "scope",
    "text",
    "status",
    "visibility",
    "pinned",
    "provenance",
    "createdAt",
    "updatedAt"
  ],
  "title": "Design Memory Record",
  "type": "object"
}
