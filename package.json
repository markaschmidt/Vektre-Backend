{
  "name": "vektre",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm run contracts:build && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm run contracts:build && nest start",
    "start:dev": "pnpm run contracts:build && nest start --watch",
    "start:debug": "pnpm run contracts:build && nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:collab": "pnpm run build && node dist/collaboration-yjs/yjs-server.js",
    "start:collab:prod": "node dist/collaboration-yjs/yjs-server.js",
    "lint": "pnpm run contracts:build && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "contracts:build": "tsc -p contracts/ui-builder/tsconfig.json",
    "contracts:generate": "pnpm --dir contracts/ui-builder run generate",
    "contracts:test": "pnpm --dir contracts/ui-builder run test",
    "contracts:verify": "pnpm --dir contracts/ui-builder run verify",
    "test": "pnpm run contracts:build && jest",
    "test:watch": "pnpm run contracts:build && jest --watch",
    "test:cov": "pnpm run contracts:build && jest --coverage",
    "test:debug": "pnpm run contracts:build && node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm run contracts:build && jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "^4.1.0",
    "@hocuspocus/server": "^4.1.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@supabase/supabase-js": "^2.107.0",
    "@markaschmidt/ui-builder-contracts": "file:contracts/ui-builder",
    "axios": "^1.17.0",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "lib0": "^0.2.117",
    "lru-cache": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.4.0",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
